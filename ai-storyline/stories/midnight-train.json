      "personality": [
        "由玩家选择决定"
      ],
      "goal": "活着下车",
      "secret": "三年前你坐过这趟车——你是当年事故唯一幸存者，但你不记得了",
      "speech": "由玩家选择决定"
    },
    {
      "id": "lin",
      "name": "林sir",
      "role": "support",
      "identity": "休假刑警",
      "personality": [
        "冷静",
        "重证据",
        "黑色幽默"
      ],
      "goal": "弄清乘客消失的规律",
      "secret": "他根本不是休假——他是三年前事故的专案调查员",
      "speech": "短句、冷峻、偶尔自嘲",
      "voice_sample": "“先别急着害怕。人不会凭空消失，只会被人‘拿走’。”"
    },
    {
      "id": "aunt",
      "name": "葛姨",
      "role": "red_herring",
      "identity": "叫卖茶叶蛋的乘务员",
      "personality": [
        "热络",
        "絮叨",
        "记性极好"
      ],
      "goal": "保护当年的遇难者",
      "secret": "她记得一切，但选择沉默",
      "speech": "方言味，爱拉家常，句句像闲话又句句有信息",
      "voice_sample": "“小伙子，蛋要趁热吃。凉了，人就认不得路喽。”"
    },
    {
      "id": "boy",
      "name": "小满",
      "role": "victim",
      "identity": "独自乘车找妈妈的小男孩，总在玩一块缺角的怀表",
      "personality": [
        "童言无忌",
        "常问让人后背发凉的问题"
      ],
      "goal": "找到妈妈",
      "secret": "他是当年第一个消失的孩子；怀表是车长的",
      "speech": "稚气、跳跃、偶尔冒出冰冷的话",
      "voice_sample": "“叔叔，你为什么能看见我呀？别人都看不见我。”"
    }
