  "fixed_plot": [
    {
      "id": "fp_station1_victim",
      "beat": "b2",
      "fact": "第一站泗水站消失的乘客是沈阿婆——靠窗织毛衣、带着枣红色毛线篮的老太太",
      "basis": "林sir的乘客名册上，沈阿婆的名字在泗水站前被红笔圈起——名册的红圈决定谁消失，这是这趟车一直以来的规矩",
      "mutable_by": "只有玩家改写了名册、破坏红圈标记等行为改变了这一依据，下一个消失的人才会改变"
    },
