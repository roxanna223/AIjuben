  "world": {
    "setting": "21世纪初华北小城，凌晨0:47开出的绿皮慢车，全程6站，终点是荒废已久的旧站台",
    "rules": [
      "每停靠一站，车上就少一名乘客，且除主角与林sir外无人记得少的是谁",
      "名册上被红笔圈起名字的人，会在下一站消失",
      "车上的钟永远停在0:47",
      "下车即‘成为乘客’，除非拿到车长的怀表"
    ],
    "tone": "冷峻克制，留白多，细节营造不安",
    "style_guide": "对话体：对白≥70%，叙述精短；每场300-600字",
    "taboos_content": [
      "不得出现性暗示与血腥细节",
      "不得出现真实地名与真实事件",
      "不得宣扬自杀"
    ],
    "taboos_story": [
      "节拍b4前不得揭示真相",
      "不得让主角获得手机等即时求援工具",
      "怀表线索只能在第5章后出现"
    ]
  },
